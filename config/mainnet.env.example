# Cortex RHC mainnet operator example (chain 4663).
#
# Copy this file to the untracked root `.env.mainnet`, replace every .invalid
# provider and operator placeholder, and keep the resulting file private. This
# example deliberately contains no API keys, deployer key, Anvil URL, Anvil
# method, local liquidity override, or testnet contract address.
#
# The API/worker never receive a deployment key. A hardware wallet or encrypted
# Foundry keystore signs the operator-only commands in MAINNET-TEST.md.

# --- Edge -------------------------------------------------------------------
CORTEX_COMPOSE_PROJECT_NAME=cortex-mainnet
CORTEX_ENV_FILE=.env.mainnet
HTTP_BIND=127.0.0.1
HTTP_PORT=8091
WEB_ORIGIN=https://cortex.example.com

# --- Separate mainnet database/cache ---------------------------------------
POSTGRES_USER=cortex
POSTGRES_DB=cortex
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_base64_32
DATABASE_URL=postgresql://cortex:REPLACE_WITH_openssl_rand_base64_32@postgres:5432/cortex
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_32

# --- Mainnet research reads -------------------------------------------------
RHC_CHAIN_ID=4663
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Free-tier provider URLs only: Alchemy Free, Validation Cloud free tier, and
# the public Robinhood endpoint. Replace the free-tier key placeholders
# in the untracked file; do not use a paid/private provider for this deployment.
# The first three URLs must have independent account quotas for additive budget.
# Rotation splits stateless reads; it does not double shared-account limits.
RHC_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_FREE_ALCHEMY_KEY,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_SECOND_ACCOUNT_ALCHEMY_KEY,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_THIRD_ACCOUNT_ALCHEMY_KEY,https://mainnet.robinhood.validationcloud.io/v1/REPLACE_WITH_FREE_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com
RHC_RPC_ROTATION_SIZE=3
# All Alchemy keys still share a conservative 4 RPS/process host pacer.
RHC_RPC_RATE_LIMITS_RPS=4,4,4,1,0.5
RHC_LOGS_RPC_URLS=https://mainnet.robinhood.validationcloud.io/v1/REPLACE_WITH_FREE_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_FREE_ALCHEMY_KEY
RHC_LOGS_RPC_RATE_LIMITS_RPS=0.5,0.25,0.25

# --- Mainnet execution context ---------------------------------------------
# This is intentionally distinct from RHC research clients above.
EXECUTION_MODE=robinhood-mainnet
# Keep execution reads on the same free-tier provider set, with execution
# pacing and fallback kept separate from research jobs.
EXECUTION_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_FREE_ALCHEMY_KEY,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_SECOND_ACCOUNT_ALCHEMY_KEY,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_THIRD_ACCOUNT_ALCHEMY_KEY,https://mainnet.robinhood.validationcloud.io/v1/REPLACE_WITH_FREE_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com
EXECUTION_RPC_ROTATION_SIZE=3
EXECUTION_LOGS_RPC_URLS=https://mainnet.robinhood.validationcloud.io/v1/REPLACE_WITH_FREE_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_FREE_ALCHEMY_KEY
# Wallet-facing reads use the public URL with no provider key.
EXECUTION_WALLET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXECUTION_MANIFEST_PATH=/app/contracts/deployments/4663.json
EXECUTION_DEPLOYMENT_ID=mainnet-4663-preset-v6-zero-fee-v1
EXECUTION_DISCOVERY_INTERVAL_MS=600000
EXECUTION_POOL_STATE_INTERVAL_MS=60000
EXECUTION_DISCOVERY_MAX_CANDIDATES=24

# --- Mainnet operations -----------------------------------------------------
RPC_TIMEOUT_MS=15000
RPC_RETRY_COUNT=2
RPC_LOGS_RETRY_COUNT=1
RPC_RETRY_DELAY_MS=250
RPC_DEFAULT_RPS=1
RPC_LOGS_DEFAULT_RPS=0.25
RPC_CONCURRENCY_CAP=8
RPC_INTERACTIVE_RESERVED=2
RPC_CIRCUIT_FAILURE_THRESHOLD=3
RPC_CIRCUIT_OPEN_MS=30000
RPC_STALLED_HEAD_MS=180000
RPC_METRICS_TTL_SEC=900
RPC_LOG_PROBE_MAX_BLOCKS=500
VAULT_INDEXER_START_BLOCK=0
VAULT_INDEXER_CONFIRMATIONS=5
VAULT_INDEXER_CHUNK_BLOCKS=500
VAULT_INDEXER_MAX_CHUNKS_PER_RUN=10
VAULT_INDEXER_CHECKPOINT_RETENTION=128
TRANSFER_INDEXER_CONFIRMATIONS=5
TRANSFER_INDEXER_CHUNK_BLOCKS=500
TRANSFER_INDEXER_MAX_CHUNKS_PER_RUN=10
TRANSFER_INDEXER_RPC_PACING_MS=500
TRANSFER_INDEXER_MAX_RATE_LIMIT_RETRIES=2

# Free Robinhood REST research source.
RHJ_BASE_URL=https://api.robinhood.com/rhj

# Do not add LOCAL_CHAIN_MODE, FORK_RPC_URL, EXECUTION_WALLET_RPC_URL pointing
# at Anvil, anvil_* credentials, RHC_TESTNET_* deployment addresses, or
# DEV_LOCAL_REDEEM_DEPTH_USD to this file.
NODE_ENV=production
