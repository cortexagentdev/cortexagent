{
  "name": "cortex-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "worker": "SERVICE_NAME=cortex-worker bun src/worker.ts",
    "chain:check": "bun src/chain/dev-check.ts",
    "contracts:check": "bun scripts/contract-constants-check.ts",
    "theme:check": "bun test scripts/public-deployment-security.test.ts scripts/presets-security.test.ts",
    "rhj:check": "bun scripts/rhj-check.ts",
    "universe:check": "bun scripts/universe-check.ts",
    "price:check": "bun scripts/price-check.ts",
    "session:check": "bun scripts/session-check.ts",
    "execution:registry-status": "bun scripts/registry-status.ts",
    "execution:bootstrap-presets": "bun scripts/bootstrap-presets.ts",
    "execution:quote": "bun scripts/execution-quote.ts",
    "execution:indexer-recovery": "bun scripts/indexer-recovery.ts",
    "execution:prepare-mainnet-handoff": "bun scripts/prepare-mainnet-handoff.ts",
    "execution:finalize-mainnet-manifest": "bun scripts/finalize-mainnet-manifest.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@trpc/server": "^11.18.0",
    "bullmq": "^6.1.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9",
    "satori": "^0.33.4",
    "superjson": "^2.2.6",
    "viem": "^2.55.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  }
}
