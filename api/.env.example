# cortex-api environment
#
# Copy to api/.env and fill in. Every variable below is read by src/env.ts, which
# parses at import time and refuses to start on anything missing or malformed.
# Never commit api/.env, and never move a secret behind a VITE_ prefix: those are
# inlined into the public client bundle.

# --- Required ---------------------------------------------------------------

# Postgres with the TimescaleDB extension.
# Local dev stack: `docker compose -f ../docker-compose.dev.yml up -d` at the repo root.
# Host port is 5433, not 5432: see docker-compose.dev.yml for why.
DATABASE_URL=postgres://cortex:cortex@127.0.0.1:5433/cortex

# Redis, used for the cache and for BullMQ.
REDIS_URL=redis://127.0.0.1:6380

# Robinhood free REST base. No auth, 60 rps.
# Serves /assets, /prices/{symbol}, /corporate-actions, /price-deviations.
RHJ_BASE_URL=https://api.robinhood.com/rhj

# Signing secret for the SIWE session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Optional, defaults shown ------------------------------------------------

# Robinhood Chain mainnet. All terminal data reads target this chain.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional ordered general-read endpoints. Keep keyed URLs in the untracked
# api/.env file; this example uses placeholders only.
# RHC_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://mainnet.robinhood.validationcloud.io/v1/YOUR_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com
# RHC_RPC_RATE_LIMITS_RPS=4,1,0.5
# `eth_getLogs` fallback order and independent pacing. Validation Cloud and
# public Robinhood are the preferred free candidates; free Alchemy is bounded
# by its small log-range limit and stays last.
# RHC_LOGS_RPC_URLS=https://mainnet.robinhood.validationcloud.io/v1/YOUR_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# RHC_LOGS_RPC_RATE_LIMITS_RPS=0.5,0.25,0.25
RHC_CHAIN_ID=4663

# RPC operation limits and the redacted metrics snapshot. The transport retries
# are bounded; execution plans also refuse a stalled/disagreeing head.
RPC_TIMEOUT_MS=15000
RPC_RETRY_COUNT=2
RPC_LOGS_RETRY_COUNT=1
RPC_RETRY_DELAY_MS=250
RPC_DEFAULT_RPS=4
RPC_LOGS_DEFAULT_RPS=0.5
RPC_CONCURRENCY_CAP=8
RPC_INTERACTIVE_RESERVED=2
RPC_CIRCUIT_FAILURE_THRESHOLD=3
RPC_CIRCUIT_OPEN_MS=30000
RPC_STALLED_HEAD_MS=180000
RPC_METRICS_TTL_SEC=900
RPC_LOG_PROBE_MAX_BLOCKS=500

# Robinhood Chain testnet (46630). Vault writes only, and testnet only.
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RHC_TESTNET_WALLET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Execution is separate from mainnet research. Leave unset for research-only
# operation. The manifest is server-only and must include the local marker.
# EXECUTION_MODE=local-fork
# EXECUTION_RPC_URLS=http://anvil:8545
# EXECUTION_LOGS_RPC_URLS=http://anvil:8545
# EXECUTION_WALLET_RPC_URL=http://127.0.0.1:8545
# EXECUTION_MANIFEST_PATH=/app/contracts/deployments/local-execution-manifest.json
# EXECUTION_DEPLOYMENT_ID=replace-with-persistent-local-generation
# EXECUTION_DISCOVERY_INTERVAL_MS=600000
# EXECUTION_POOL_STATE_INTERVAL_MS=60000
# EXECUTION_DISCOVERY_MAX_CANDIDATES=24

# CORS allowlist, development only. Production serves web and api on one origin
# behind the reverse proxy, so no CORS header is emitted there. The Lovable
# vite-tanstack config binds the web dev server to :8080.
WEB_ORIGIN=http://localhost:8080

# Stamped on every log line. The worker script overrides this to cortex-worker.
SERVICE_NAME=cortex-api

PORT=3001

# Jobs the BullMQ worker runs concurrently.
WORKER_CONCURRENCY=4
WORKER_BACKLOG_CAP=100

# --- Universe gate (BE-5) ----------------------------------------------------

# How far the Chainlink answer may sit from the independent /rhj/prices midpoint
# before the feed counts as disagreeing. This is the freshness test; feed age is
# recorded and displayed but is never a rejection rule. Keep it above the feed's
# own 0.5% deviation threshold, or a healthy feed drifting inside its own band
# reads as divergent.
UNIVERSE_FEED_TOLERANCE_PCT=1

# Gate 2 floor, in USD of sampled pool depth. Zero because api/data/pools.json
# ships empty: with no venue registry for RHC on the free tier, a non-zero floor
# would exclude every asset for a gap in Cortex's own data. Populate the
# registry and raise this together.
UNIVERSE_DEPTH_FLOOR_USD=0

# Gate 3 floor: the smallest simulated redeem worth calling redeemable.
UNIVERSE_MIN_REDEEM_USD=0

# --- Signals: FLOW processor (BE-11) ---------------------------------------

# |zScore| of the window's net issuance figure against the 30-day trailing
# baseline at or above which a FLOW signal fires. 3 lines up with the rank
# curve's half-power point.
SIGNAL_FLOW_Z_THRESHOLD=3

# Window FLOW attributes the observed mint/burn figure to, ISO-8601 duration
# (PT<n>H and/or PT<n>M). Anchored to the shared window end, so the signal id is
# unaffected; only the reported span moves.
SIGNAL_FLOW_WINDOW_ISO=PT4H

# --- Signals: PEG_DRIFT processor (BE-12) ---------------------------------

# How far the on-chain DEX price may sit from the Chainlink reference before the
# pair counts as diverging, and the pairwise tolerance for the
# DEX/Chainlink/quote agreement check. Keep it above the feed's own 0.5%
# deviation threshold.
SIGNAL_PEG_DRIFT_TOLERANCE_PCT=1

# |zScore| of the DEX-to-Chainlink divergence against the 30-day trailing
# baseline at or above which a PEG_DRIFT signal fires. The tolerance gate and
# this z gate must both trip.
SIGNAL_PEG_DRIFT_Z_THRESHOLD=3

# Sampled pool depth, in USD, below which the DEX read is treated as thin and
# the signal is capped at LOW confidence. Zero disables the check while
# api/data/pools.json ships empty.
SIGNAL_PEG_DRIFT_MIN_DEPTH_USD=0

# --- Signals: CORPORATE_ACTION processor (BE-13) ------------------------

# The window a CORPORATE_ACTION signal attributes its observation to. Corporate
# actions are scheduled multi-day events, not intraday moves, so the default is
# one day. Accepts day and hour spans only (e.g. P1D, P2DT12H), never minutes.
SIGNAL_CORPORATE_ACTION_WINDOW_ISO=P1D

# --- Signals: AFTER_HOURS_DISLOCATION processor (BE-14) ------------------

# Signed percentage move of the on-chain price over the window at or above which
# an AFTER_HOURS_DISLOCATION signal fires, and only while the reference equity
# market is not in its regular session. A move this size during RTH belongs to
# PEG_DRIFT or LIQUIDITY_SHIFT, not this kind.
SIGNAL_AFTER_HOURS_THRESHOLD_PCT=2

# Window the move is measured over, ISO-8601 duration (PT<n>H and/or PT<n>M).
# Anchored to the shared window end, so the signal id is unaffected.
SIGNAL_AFTER_HOURS_WINDOW_ISO=PT2H

# Sampled on-chain depth, in USD, below which the overnight book is thin and
# confidence is reduced. Zero still counts as thin; a positive value that clears
# this floor is what lifts a signal to MED.
SIGNAL_AFTER_HOURS_MIN_DEPTH_USD=0

# --- Transfer indexer (BE-15) ---------------------------------------------

# Confirmations the forward-only Transfer indexer stays behind chain head, so a
# shallow reorg is resolved before its logs are applied. The indexer starts at
# the head at first run and only moves forward; it never backfills from genesis.
TRANSFER_INDEXER_CONFIRMATIONS=5

# Block span per eth_getLogs request. The live free public endpoint was measured
# at 500 blocks for the current address set; adaptive halving handles narrower
# provider limits.
TRANSFER_INDEXER_CHUNK_BLOCKS=500

# Chunks applied in one cycle. A lower cap prevents a cold or recovering worker
# from creating a burst against all free log providers.
TRANSFER_INDEXER_MAX_CHUNKS_PER_RUN=10

# Pause between log requests and stop retrying a rate-limited range in the same
# cycle. The next scheduled cycle resumes from the durable cursor.
TRANSFER_INDEXER_RPC_PACING_MS=500
TRANSFER_INDEXER_MAX_RATE_LIMIT_RETRIES=2

# --- Signals: HOLDER_CONCENTRATION processor (BE-15) ---------------------

# Absolute day-over-day change in top-N holder share, in percentage points, at
# or above which a HOLDER_CONCENTRATION signal fires.
SIGNAL_HOLDER_CONCENTRATION_MIN_DELTA_PP=1

# N in "top-N holder share". PART 3's example is the top decile.
SIGNAL_HOLDER_CONCENTRATION_TOP_N=10

# Candidate addresses per token whose balanceOfUI() is read for the ranking. The
# set is the largest indexed balances; a larger number is more accurate and
# costs more chain reads.
SIGNAL_HOLDER_CONCENTRATION_CANDIDATES=50

# --- Signals: LIQUIDITY_SHIFT processor (BE-16) ------------------------

# Signed USD change in sampled pool depth over the window at or above which the
# change is treated as material. This is a materiality threshold, not a health
# check: a smaller change is not suppressed, it is emitted at LOW confidence and
# logged for pattern tracking.
SIGNAL_LIQUIDITY_SHIFT_MIN_DEPTH_USD=100000

# |zScore| of the window depth change against the 30-day trailing baseline the
# change must also clear to count as material. Both this and the USD threshold
# must trip for a signal above LOW confidence.
SIGNAL_LIQUIDITY_SHIFT_Z_THRESHOLD=3

# Window the depth change is measured over, ISO-8601 duration (PT<n>H and/or
# PT<n>M). Anchored to the shared window end, so the signal id is unaffected.
SIGNAL_LIQUIDITY_SHIFT_WINDOW_ISO=PT4H

# --- Vault indexing (BE-26) ---------------------------------------------

# The ThemeFactory address on RHC testnet (46630), recorded after the BE-25e
# deploy. The vault indexer and the NAV poller no-op until this is set. There is
# no default: an invented address would watch nothing while looking healthy.
# Testnet only, always (locked decision 5).
# RHC_TESTNET_THEME_FACTORY=0x0000000000000000000000000000000000000000

# Block the vault indexer begins from on its first run. Set to the factory's
# deploy block so the ThemeDeployed log is caught. The default of 0 scans from
# genesis and catches up over several capped cycles.
VAULT_INDEXER_START_BLOCK=0

# Confirmations the vault indexer stays behind testnet head, so a shallow reorg
# is resolved before its logs are applied.
VAULT_INDEXER_CONFIRMATIONS=5

# Block span per eth_getLogs request.
VAULT_INDEXER_CHUNK_BLOCKS=2000

# Chunks applied in one cycle, so a long outage or a genesis cold start catches
# up over several cycles rather than one unbounded run.
VAULT_INDEXER_MAX_CHUNKS_PER_RUN=25
# Retained chunk-boundary hashes for bounded common-ancestor recovery.
VAULT_INDEXER_CHECKPOINT_RETENTION=128

# --- Theme construction (FE-5, BE-29) ------------------------------------
#
# THREE values are required before a theme can be deployed, and all three are
# commented out below because none of them has been sourced yet:
#
#   RHC_TESTNET_THEME_FACTORY   (in the BE-26 block above)
#   RHC_TESTNET_USDG
#   RHC_TESTNET_SWAP_VENUES
#
# They are the policy fields ThemeFactory.deployTheme() rejects as address(0)
# and as an empty array, and none can be derived from the C1 universe: that data
# describes mainnet 4663 and a theme deploys to testnet 46630 (locked decisions
# 5 and 6). None has a default, and none is guessed.
#
# themeRouter.readiness() reports which of the three are unset, by name, so the
# Act On It surface disables the deploy step with a specific reason instead of
# failing after a user has approved a policy. themeRouter.deploy() refuses with
# the same list rather than encoding anything. An invented address here would
# produce a permanently broken immutable vault, and there is no rescue function.
#
# Once the factory is broadcast, record it in contracts/deployments/46630.json
# too, and keep that file and this one in step.

# USDG (settlement) on testnet 46630, for the routed mint / redeem paths. In-kind
# redeem never touches it.
# RHC_TESTNET_USDG=0x0000000000000000000000000000000000000000

# Rebalance venue allowlist on testnet 46630, comma separated. The keeper may
# trade nowhere else, so an empty list is an unbuildable policy, not a
# permissive default.
# RHC_TESTNET_SWAP_VENUES=0x0000000000000000000000000000000000000000

# development | test | production
NODE_ENV=development
