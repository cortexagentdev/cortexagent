# Cortex configuration (OPS-3). Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# One .env file per host, referenced by `env_file:` in docker-compose.prod.yml.
# The values below are written for the containerised stack, where services
# resolve each other by compose service name.
#
# This is not the file host-run development uses. `bun run dev` inside api/
# reads `api/.env`, which points at the ports docker-compose.dev.yml publishes
# (127.0.0.1:5433 and 127.0.0.1:6380). The two files are deliberately separate:
# one describes a stack talking to itself over a compose network, the other
# describes a process on your laptop talking to two containers.
#
# `.env` is gitignored and must stay that way. Verify before you put a real
# value in it:
#
#   git check-ignore .env
#
# A committed secret has to be rotated, not deleted, so prevention is the only
# cheap moment. Generate the two secrets below on the host, never by hand:
#
#   openssl rand -base64 32
#
# ANYTHING PREFIXED `VITE_` IS PUBLIC. Vite inlines those into the client
# bundle at build time, so a secret behind that prefix is shipped to every
# visitor (global do-not 18). There is no way to un-ship it.
#
# CONTRACT DEPLOYER KEYS DO NOT BELONG HERE, or anywhere on this host. The
# vault has no rescue function, so a compromised deployer is unrecoverable
# (CortexBackend.md PART 1). Deployment uses separate infrastructure.

# --- Edge -------------------------------------------------------------------
# The single published port, on the caddy service. Bound to loopback by
# default; on the VPS a Cloudflare Tunnel forwards the public domain to it, so
# the host needs no inbound firewall opening. Set HTTP_BIND to 0.0.0.0 only if
# something other than a host-local process has to reach it.
#
# There is no DOMAIN variable. TLS terminates at Cloudflare, so Caddy serves
# plain HTTP on one port and never requests a certificate (see the Caddyfile).
#
# 8090 and not 8080: the Vite dev server binds 8080 on IPv6 (*:8080) while
# Docker publishes on IPv4, so the two coexist without a port conflict and
# `localhost:8080` quietly reaches the dev server instead of this stack.
HTTP_BIND=127.0.0.1
HTTP_PORT=8090

# --- Postgres + TimescaleDB --------------------------------------------------
# The password is consumed twice: by the postgres service, and inside
# DATABASE_URL. They must match, or the api fails to connect against a database
# that is running perfectly well.
POSTGRES_USER=cortex
POSTGRES_DB=cortex
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# Host is `postgres`, the compose service name. The port is never published to
# the host (global do-not 17); reach it with `docker compose exec postgres psql`.
DATABASE_URL=postgresql://cortex:CHANGE_ME_openssl_rand_base64_32@postgres:5432/cortex

# --- Redis -------------------------------------------------------------------
# Cache and BullMQ. Also never published.
REDIS_URL=redis://redis:6379

# --- Robinhood Chain ---------------------------------------------------------
# Mainnet 4663. Every data read targets this chain (locked decision 6).
# NOT `rpc.robinhood.com`: that host resolves and serves a certificate, then
# refuses the handshake, so the mistake reads like a local network fault.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Every mainnet endpoint for general reads (eth_call, blocks), best first,
# comma separated. Ordered fallback by default. A keyed
# Alchemy endpoint answers these in 40-60ms against ~1s on the public host, so
# it belongs first. Falls back to RHC_RPC_URL when unset.
#
# These URLs carry an API key in the path. Keep them out of git and out of
# screenshots; the api logs the host only, never the full URL.
# RHC_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY,https://mainnet.robinhood.validationcloud.io/v1/YOUR_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com
# For two keys with independent account quotas, put both Alchemy URLs first
# and set this to 2. Only the first N endpoints rotate; others remain fallbacks.
# Keys in one account do NOT create extra account quota. Logs never rotate.
RHC_RPC_ROTATION_SIZE=1
# Per-endpoint general-read pacing, matching RHC_RPC_URLS order. These are
# conservative application limits, not advertised provider quotas. Same-host
# keys share the lowest configured rate per process (not the sum).
# RHC_RPC_RATE_LIMITS_RPS=4,1,0.5
# With two Alchemy keys: RHC_RPC_RATE_LIMITS_RPS=4,4,1,0.5
# With three independently budgeted keys: put all three URLs first, set
# RHC_RPC_ROTATION_SIZE=3 and RHC_RPC_RATE_LIMITS_RPS=4,4,4,1,0.5.
# This distributes requests; it does not reduce total compute-unit consumption.

# Endpoints for eth_getLogs only, best first. Separate because the ranking
# inverts for this one method: Validation Cloud and the public host are the
# preferred free candidates, while Alchemy's FREE tier refuses any log query
# wider than 10 blocks. The fallback order is explicit and each host is paced
# independently. Keep keyed URLs out of git and screenshots.
# RHC_LOGS_RPC_URLS=https://mainnet.robinhood.validationcloud.io/v1/YOUR_VALIDATION_CLOUD_KEY,https://rpc.mainnet.chain.robinhood.com,https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# RHC_LOGS_RPC_RATE_LIMITS_RPS=0.5,0.25,0.25
RHC_CHAIN_ID=4663

# RPC operations. Counts are taken at the JSON-RPC HTTP boundary; the method
# unit values are labeled estimates for the versioned provider table in code.
RPC_TIMEOUT_MS=15000
RPC_RETRY_COUNT=2
RPC_LOGS_RETRY_COUNT=1
RPC_RETRY_DELAY_MS=250
RPC_DEFAULT_RPS=4
RPC_LOGS_DEFAULT_RPS=0.5
RPC_CONCURRENCY_CAP=8
RPC_INTERACTIVE_RESERVED=2
RPC_CIRCUIT_FAILURE_THRESHOLD=3
RPC_CIRCUIT_OPEN_MS=30000
RPC_STALLED_HEAD_MS=180000
RPC_METRICS_TTL_SEC=900
RPC_LOG_PROBE_MAX_BLOCKS=500

# Testnet 46630. Vault writes only (locked decision 5).
RHC_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Public RPC offered to wallets. local-chain.sh wire sets this to loopback.
# Never put a provider API key in this URL.
RHC_TESTNET_WALLET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Execution identity -----------------------------------------------------
# Research always uses RHC_RPC_URLS. Transaction planning uses only this
# separately verified context. Leave this entire block unset for research-only
# installs; Cortex then reports execution as unconfigured and issues no plans.
# EXECUTION_MODE=local-fork
# EXECUTION_RPC_URLS=http://anvil:8545
EXECUTION_RPC_ROTATION_SIZE=1
# EXECUTION_LOGS_RPC_URLS=http://anvil:8545
# EXECUTION_WALLET_RPC_URL=http://127.0.0.1:8545
# EXECUTION_MANIFEST_PATH=/app/contracts/deployments/local-execution-manifest.json
# EXECUTION_DEPLOYMENT_ID=replace-with-persistent-local-generation

# Local Anvil defaults to a persistent mainnet fork. Uses the first RHC_RPC_URLS
# endpoint for archive state, or FORK_RPC_URL when set. Its block is pinned in
# the Docker volume on first startup; restarts restore the same block and state.
LOCAL_CHAIN_MODE=fork
# FORK_RPC_URL=
# FORK_BLOCK_NUMBER=

# Robinhood free REST base. No auth, 60 rps (locked decision 7).
RHJ_BASE_URL=https://api.robinhood.com/rhj

# --- Sessions ----------------------------------------------------------------
# Signs the SIWE session JWTs. Rotating it logs everybody out, which is the
# correct response to a suspected leak.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Web / API origin --------------------------------------------------------
# The origin users actually browse, scheme and port included. NOT dev-only.
#
# Two jobs. It is the credentialed CORS allowlist in every environment.
# It is also the domain SIWE binds
# every sign-in message to: authRouter.verify rejects a message naming any other
# host, so a signature captured for another site cannot be replayed here.
#
# A wrong value fails closed and misleadingly: the terminal works, and every
# sign-in returns "Sign-in message failed validation", which reads like a wallet
# fault rather than a configuration one. Check the api log for
# `siwe field validation failed` with `reason: domain does not match`.
#
# Local compose stack:  http://127.0.0.1:8090   (must match HTTP_PORT above)
# VPS:                  https://cortexagent.tech (the web origin, not the API)
WEB_ORIGIN=http://127.0.0.1:8090

# Public frontend build variable; set in Vercel and rebuild the web deployment.
# Include /trpc. HTTPS sibling domains are same-site; credentialed CORS permits
# the web origin. Unset keeps the relative /trpc proxy for the all-in-one stack.
# VITE_API_URL=https://api.cortexagent.tech/trpc
# For local web + local API: VITE_API_URL=http://localhost:3001/trpc

# --- Workers -----------------------------------------------------------------
# Jobs the worker runs at once. Deliberately low: one box shares its cores with
# Postgres and the SSR web server.
WORKER_CONCURRENCY=4
WORKER_BACKLOG_CAP=100

# --- Transfer log load ------------------------------------------------------
# The indexer is forward-only and resumes from its durable cursor. Keep its
# per-cycle catch-up budget small when the research log list is all free-tier
# providers; a later cycle continues rather than replaying a large burst.
TRANSFER_INDEXER_CONFIRMATIONS=5
TRANSFER_INDEXER_CHUNK_BLOCKS=500
TRANSFER_INDEXER_MAX_CHUNKS_PER_RUN=10
TRANSFER_INDEXER_RPC_PACING_MS=500
TRANSFER_INDEXER_MAX_RATE_LIMIT_RETRIES=2

# --- Vault, testnet 46630 (optional) -----------------------------------------
# Unset until C2 deploys the factory to testnet (BE-25e). The vault indexer and
# the NAV poller no-op while these are empty, rather than inventing an address
# and watching nothing while appearing to work.
# RHC_TESTNET_THEME_FACTORY=0x0000000000000000000000000000000000000000
# Set to the factory's deploy block so the ThemeDeployed log is caught. The
# default of 0 scans testnet from genesis, which works but takes several capped
# catch-up cycles to reach head.
# VAULT_INDEXER_START_BLOCK=0
# The USDG settlement token on testnet, for the routed mint and redeem paths.
# In-kind redeem never touches it (Design Law 7).
# RHC_TESTNET_USDG=0x0000000000000000000000000000000000000000
# The swap venue allowlist, comma separated. User-requested swaps may route nowhere
# else, so an empty list is not a permissive default, it is an unbuildable
# policy and themeRouter.deploy refuses to encode a transaction without it.
# RHC_TESTNET_SWAP_VENUES=
